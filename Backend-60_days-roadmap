<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>60-Day Node.js Backend Engineering Roadmap</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0e0e0f;--surface:#16161a;--surface2:#1e1e24;--border:#2a2a35;--border2:#3a3a48;
  --green:#00d97e;--green-dim:#00d97e22;--green-mid:#00d97e55;
  --amber:#f5a623;--amber-dim:#f5a62322;
  --blue:#4da6ff;--blue-dim:#4da6ff22;
  --red:#ff5f5f;--red-dim:#ff5f5f22;
  --purple:#a78bfa;--purple-dim:#a78bfa22;
  --cyan:#22d3ee;--cyan-dim:#22d3ee22;
  --text:#e8e8f0;--text2:#8888a0;--text3:#55556a;
  --mono:'IBM Plex Mono',monospace;--sans:'IBM Plex Sans',sans-serif;
  --radius:6px;--radius-lg:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;line-height:1.6;min-height:100vh}
.page{max-width:960px;margin:0 auto;padding:2.5rem 1.5rem 4rem}

/* header */
.header{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}
.header-top{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.title-block h1{font-family:var(--mono);font-size:20px;font-weight:500;color:var(--green);letter-spacing:-0.5px;margin-bottom:4px}
.title-block h1 span{color:var(--text2)}
.title-block p{font-size:13px;color:var(--text2);max-width:500px;line-height:1.5}
.reset-btn{font-family:var(--mono);font-size:11px;padding:5px 12px;border:1px solid var(--border2);border-radius:var(--radius);background:transparent;color:var(--text3);cursor:pointer;transition:all 0.15s;white-space:nowrap}
.reset-btn:hover{border-color:var(--red);color:var(--red)}

/* progress */
.progress-section{margin-top:1.25rem}
.progress-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.progress-meta span{font-family:var(--mono);font-size:12px;color:var(--text2)}
.progress-meta .pct{color:var(--green);font-weight:500}
.progress-track{height:3px;background:var(--border);border-radius:99px;overflow:hidden}
.progress-fill{height:3px;background:var(--green);border-radius:99px;transition:width 0.5s cubic-bezier(0.4,0,0.2,1);box-shadow:0 0 8px var(--green-mid)}
.phase-stats{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem}
.stat{font-family:var(--mono);font-size:11px;color:var(--text3);display:flex;align-items:center;gap:6px}
.stat-dot{width:6px;height:6px;border-radius:50%}

/* tabs */
.tabs{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:1.5rem}
.tab{font-family:var(--mono);font-size:11px;padding:5px 11px;border-radius:var(--radius);border:1px solid var(--border);background:transparent;color:var(--text3);cursor:pointer;transition:all 0.15s;white-space:nowrap}
.tab:hover{border-color:var(--border2);color:var(--text2)}
.tab.active{background:var(--green-dim);border-color:var(--green-mid);color:var(--green)}

/* detail panel */
.detail{background:var(--surface);border:1px solid var(--border2);border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1.5rem;animation:slideIn 0.15s ease}
@keyframes slideIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.detail-header{display:flex;align-items:flex-start;gap:12px;margin-bottom:1rem}
.detail-day-badge{font-family:var(--mono);font-size:11px;font-weight:500;padding:4px 10px;border-radius:var(--radius);white-space:nowrap;flex-shrink:0}
.detail-title{font-size:15px;font-weight:500;color:var(--text);line-height:1.4}
.detail-tags{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:1rem}
.dtag{font-family:var(--mono);font-size:10px;padding:2px 8px;border-radius:var(--radius);border:1px solid var(--border2);color:var(--text2);background:var(--surface2)}
.detail-tasks{margin-bottom:1rem}
.detail-tasks h4{font-family:var(--mono);font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.task-list{list-style:none;display:flex;flex-direction:column;gap:4px}
.task-list li{font-size:13px;color:var(--text2);padding-left:16px;position:relative}
.task-list li::before{content:"→";position:absolute;left:0;color:var(--text3);font-family:var(--mono)}
.detail-btns{display:flex;gap:8px;flex-wrap:wrap}
.detail-btns button{font-family:var(--mono);font-size:11px;padding:6px 14px;border-radius:var(--radius);border:1px solid var(--border2);background:transparent;color:var(--text2);cursor:pointer;transition:all 0.15s}
.detail-btns button:hover{border-color:var(--border2);color:var(--text)}
.detail-btns .btn-done{border-color:var(--green-mid);color:var(--green);background:var(--green-dim)}
.detail-btns .btn-done:hover{background:var(--green-dim)}
.detail-btns .btn-undone{border-color:var(--border2);color:var(--text2)}
.detail-btns .btn-close{margin-left:auto}

/* phase block */
.phase-block{margin-bottom:2.5rem}
.phase-header{display:flex;align-items:center;gap:10px;margin-bottom:1rem;padding-bottom:0.75rem;border-bottom:1px solid var(--border)}
.phase-label{font-family:var(--mono);font-size:11px;font-weight:500;padding:3px 10px;border-radius:99px}
.phase-name{font-size:14px;font-weight:400;color:var(--text)}
.phase-range{font-family:var(--mono);font-size:11px;color:var(--text3);margin-left:auto;white-space:nowrap}
.phase-done-count{font-family:var(--mono);font-size:11px;color:var(--text2)}

/* grid */
.days-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:7px;margin-bottom:1rem}
.day-card{border:1px solid var(--border);border-radius:var(--radius);padding:10px 11px;cursor:pointer;transition:all 0.15s;background:var(--surface);position:relative;overflow:hidden}
.day-card::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity 0.15s}
.day-card:hover{border-color:var(--border2)}
.day-card:hover::before{opacity:1}
.day-card.done{border-color:var(--green-mid);background:var(--green-dim)}
.day-card.done .d-num{color:var(--green)}
.day-card.done .d-topic{color:var(--green);opacity:0.85}
.day-card.selected{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue-dim)}
.d-num{font-family:var(--mono);font-size:10px;color:var(--text3);margin-bottom:4px;font-weight:500}
.d-topic{font-size:12px;color:var(--text2);line-height:1.4}
.d-check{position:absolute;top:8px;right:8px;width:14px;height:14px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s}
.day-card.done .d-check{opacity:1}
.d-check svg{width:8px;height:8px;stroke:#000;stroke-width:3;fill:none}

/* milestone */
.milestone{font-family:var(--mono);font-size:12px;color:var(--text2);padding:10px 14px;background:var(--surface2);border-left:2px solid;border-radius:0 var(--radius) var(--radius) 0;line-height:1.5}
.milestone strong{font-weight:500}

@media(max-width:520px){.days-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}.phase-name{display:none}}
</style>
</head>
<body>
<div class="page">
  <div class="header">
    <div class="header-top">
      <div class="title-block">
        <h1><span>$ </span>node --roadmap <span style="color:var(--amber)">60days</span></h1>
        <p>Backend engineering with Node.js — from server fundamentals to senior-level architecture, APIs, databases, DevOps, and system design.</p>
      </div>
      <button class="reset-btn" onclick="resetAll()">reset progress</button>
    </div>
    <div class="progress-section">
      <div class="progress-meta">
        <span id="plabel">0 / 60 days completed</span>
        <span class="pct" id="ppct">0%</span>
      </div>
      <div class="progress-track"><div class="progress-fill" id="pbar" style="width:0%"></div></div>
      <div class="phase-stats" id="phase-stats"></div>
    </div>
  </div>

  <div class="tabs" id="tabs"></div>
  <div id="detail-area"></div>
  <div id="phase-area"></div>
</div>

