      {d:54,topic:"Multi-tenancy architecture",tags:["Row-level security","Schema-per-tenant","Tenant isolation","Feature flags","Billing gates"],
       tasks:["Row-level security in PostgreSQL","Tenant context middleware","Tenant-aware migrations","Build: multi-tenant SaaS API skeleton"]},
      {d:55,topic:"Backend system design practice",tags:["URL shortener","Twitter clone","Uber backend","Notification system","Rate limiter"],
       tasks:["Design a URL shortener at scale","Design a notification system (push, email, SMS)","Design a real-time leaderboard","Practice structured system design answers"]},
      {d:56,topic:"API versioning + backwards compatibility",tags:["URI versioning","Header versioning","Deprecation","Changelog","Sunset header"],
       tasks:["Strategy: URI vs header versioning","Deprecation notices and Sunset header","Maintain v1 while shipping v2","Build: versioned API migration guide"]},
      {d:57,topic:"Developer experience + DX",tags:["SDK generation","OpenAPI","Type generation","Error messages","Onboarding docs","Changelog"],
       tasks:["Auto-generate SDK from OpenAPI spec","Clear, actionable API error messages","Write onboarding guide for new contributors","Build: contributor guide and ADR examples"]},
      {d:58,topic:"Open source + community",tags:["Good first issues","Semantic versioning","npm publish","Changelogs","RFC process"],
       tasks:["Publish a Node.js utility package to npm","Write changelog with conventional commits","Triage issues and review PRs","Contribute to an open source Node.js project"]},
      {d:59,topic:"Interview preparation",tags:["JS runtime questions","System design","Coding problems","Behavioural","Salary negotiation"],
       tasks:["Review top 50 Node.js interview questions","Practice 2 system design problems","Solve 10 LeetCode medium (graphs, DP)","Polish resume and GitHub profile"]},
      {d:60,topic:"Final project + demo day",tags:["Portfolio","Live demo","Architecture diagram","Case study","Video walkthrough"],
       tasks:["Record a 5-minute demo of your main project","Write architecture decision records (ADRs)","Add Lighthouse/performance score to README","Final mock interview: technical + system design + behavioural"]},
    ]
  }
];

const KEY="nodejs60_v1";
let done=new Set(JSON.parse(localStorage.getItem(KEY)||"[]"));
let active="all";
let sel=null;

function save(){localStorage.setItem(KEY,JSON.stringify([...done]))}

function renderProgress(){
  const pct=Math.round((done.size/60)*100);
  document.getElementById("pbar").style.width=pct+"%";
  document.getElementById("plabel").textContent=`${done.size} / 60 days completed`;
  document.getElementById("ppct").textContent=pct+"%";
  const stats=document.getElementById("phase-stats");
  stats.innerHTML=PHASES.map(p=>{
    const pd=p.days.filter(d=>done.has(d.d)).length;
    return `<span class="stat"><span class="stat-dot" style="background:${p.color}"></span><span style="color:${p.color}">${p.label}</span><span>${pd}/${p.days.length}</span></span>`;
  }).join("");
}

function renderTabs(){
  const c=document.getElementById("tabs");
  c.innerHTML=`<button class="tab ${active==='all'?'active':''}" onclick="setPhase('all')">$ all phases</button>`+
    PHASES.map(p=>`<button class="tab ${active===p.id?'active':''}" style="${active===p.id?`background:${p.dim};border-color:${p.mid};color:${p.color}`:''}" onclick="setPhase('${p.id}')">${p.label}: ${p.name}</button>`).join("");
}

function renderDetail(){
  const a=document.getElementById("detail-area");
  if(!sel){a.innerHTML="";return}
  let fd=null,fp=null;
  for(const p of PHASES)for(const d of p.days)if(d.d===sel){fd=d;fp=p;break}
  if(!fd){a.innerHTML="";return}
  const id=done.has(sel);
  a.innerHTML=`<div class="detail">
    <div class="detail-header">
      <span class="detail-day-badge" style="background:${fp.dim};color:${fp.text};border:1px solid ${fp.mid}">Day ${sel} · ${fp.name}</span>
      <div class="detail-title">${fd.topic}</div>
    </div>
    <div class="detail-tags">${fd.tags.map(t=>`<span class="dtag">${t}</span>`).join("")}</div>
    <div class="detail-tasks">
      <h4>Hands-on tasks</h4>
      <ul class="task-list">${fd.tasks.map(t=>`<li>${t}</li>`).join("")}</ul>
    </div>
    <div class="detail-btns">
      <button class="${id?'btn-done':'btn-undone'}" onclick="toggleDay(${sel})">${id?'✓ completed — mark incomplete':'Mark as done'}</button>
      <button onclick="window.open('https://claude.ai/new?q='+encodeURIComponent('Give me a complete Node.js study guide and project tasks for Day ${sel}: ${fd.topic}. Include code examples, best practices, and common interview questions.'),'_blank')">get study guide →</button>
      <button onclick="window.open('https://claude.ai/new?q='+encodeURIComponent('Give me 10 backend Node.js interview questions for: ${fd.topic}, with detailed answers.'),'_blank')">interview Q&A →</button>
      <button class="btn-close" onclick="sel=null;renderDetail();renderPhases()">close ✕</button>
    </div>
  </div>`;
}

function renderPhases(){
  const a=document.getElementById("phase-area");
  const ps=active==="all"?PHASES:PHASES.filter(p=>p.id===active);
  a.innerHTML=ps.map(p=>{
    const pd=p.days.filter(d=>done.has(d.d)).length;
    const cards=p.days.map(d=>{
      const id=done.has(d.d);const is_sel=sel===d.d;
      return `<div class="day-card ${id?'done':''} ${is_sel?'selected':''}" onclick="selectDay(${d.d})">
        <div class="d-num" style="${id?'':'color:var(--text3)'}">day_${String(d.d).padStart(2,'0')}</div>
        <div class="d-topic">${d.topic}</div>
        <div class="d-check"><svg viewBox="0 0 10 8"><polyline points="1,4 4,7 9,1"/></svg></div>
      </div>`;
    }).join("");
    return `<div class="phase-block">
      <div class="phase-header">
        <span class="phase-label" style="background:${p.dim};color:${p.text};border:1px solid ${p.mid}">${p.label}</span>
        <span class="phase-name">${p.name}</span>
        <span class="phase-done-count" style="color:${p.text}">${pd}/${p.days.length}</span>
        <span class="phase-range">${p.range}</span>
      </div>
      <div class="days-grid">${cards}</div>
      <div class="milestone" style="border-color:${p.text}"><strong style="color:${p.text}">milestone //</strong> ${p.milestone}</div>
    </div>`;
  }).join("");
}

function setPhase(id){active=id;renderTabs();renderPhases()}
function selectDay(d){sel=sel===d?null:d;renderDetail();renderPhases()}
function toggleDay(d){if(done.has(d))done.delete(d);else done.add(d);save();renderProgress();renderDetail();renderPhases()}
function resetAll(){if(confirm("Reset all progress?")){done=new Set();save();renderProgress();renderDetail();renderPhases()}}

renderProgress();renderTabs();renderDetail();renderPhases();
</script>
</body>
</html>
